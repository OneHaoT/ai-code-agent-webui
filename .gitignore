/.trae/
/web/config/

# ========== 运行时数据：本地图片存储（内容寻址，非源码） ==========
/image/

# ========== 日志 ==========
*.log
logs/

# ========== Java / Maven（web/） ==========
target/
*.class
*.jar
!**/maven-wrapper.jar
.idea/
*.iml

# ========== Node / Vite（ui/） ==========
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== Python（ai/） ==========
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

