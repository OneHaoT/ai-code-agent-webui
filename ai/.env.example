# ============================================================
# AI 模块环境配置示例
# 复制为 .env 后按需修改；.env 不要提交到版本库
# ============================================================

# ---- DeepSeek 接入 ----
# API Key（必填），获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI 兼容网关地址（默认官方；直连/代理异常时可换备用端点）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 主模型（deepseek-flash 支持视觉与 function calling）
DEEPSEEK_MODEL=deepseek-flash
# 记忆摘要专用模型（留空则与主模型相同）
DEEPSEEK_SUMMARY_MODEL=
# 思考模式下的推理强度：low / high / max
DEEPSEEK_REASONING_EFFORT=high

# ---- 记忆压缩 ----
# 滑动窗口保留的最近消息条数（窗口外旧消息触发摘要压缩）
MEMORY_WINDOW_SIZE=10
# 是否启用历史摘要压缩（true/false）
MEMORY_SUMMARY_ENABLED=true

# ---- 阶段1：只读工具调用 ----
# 工具总开关（true/false）；false 时退化为阶段0直连，无 tool_* 帧
TOOLS_ENABLED=true
# 工作区根目录：只读工具可访问的唯一目录树，路径越界硬拦截。
# 留空默认项目根（ai/ 的上一级）；建议写绝对路径，如 c:/Users/tgjon/Desktop/ai
WORKSPACE_ROOT=
# 单轮对话内工具循环最大轮数（超过后要求模型直接作答，仍调用工具则终止）
MAX_TOOL_ITERATIONS=8

# ---- 工具硬上限（一般无需修改，留空走默认值）----
# read_file 单次最多返回行数 / 字节数
#TOOL_MAX_LINES=2000
#TOOL_MAX_BYTES=131072
# list_dir / glob / grep 返回条目上限
#TOOL_LIST_LIMIT=500
#TOOL_GLOB_LIMIT=200
#TOOL_GREP_LIMIT=100
# grep 单次执行超时秒数
#TOOL_TIMEOUT_SECONDS=10

# ---- 阶段2：工作区语义检索（RAG） ----
# 检索开关（true/false）；false 时工具集不含 search_code、embedding 模型零加载
RAG_ENABLED=true
# embedding 模型（fastembed 模型名；默认中文小模型，首次调用自动下载 ~95MB 到 ai/model_cache/）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 检索返回命中条数上限（不开放给模型，固定值防上下文膨胀）
#RAG_TOP_K=8
# 索引 chunk 总量上限（触顶停止并提示"索引不完整"）
#RAG_MAX_CHUNKS=50000
# 单文件入索引体积上限（字节）
#RAG_MAX_FILE_BYTES=524288
# 分块行窗口与重叠行数
#RAG_CHUNK_LINES=80
#RAG_CHUNK_OVERLAP=10
# 指纹新鲜度检查间隔秒（窗口内不重复遍历工作区）
#RAG_FRESHNESS_TTL=30
# 首次索引构建同步等待秒数（须小于工具超时 10s；超时返回"构建中"）
#RAG_BUILD_WAIT_SECONDS=8
# 索引存储根目录（默认 ai/index_store，按工作区哈希分目录；不入用户工作区）
#RAG_INDEX_ROOT=

# ---- 阶段3：本地受限沙箱（写文件 + 命令执行） ----
# 写/执行工具总开关（true/false）；false 时工具集不含 write_file/run_command，回退阶段2
SANDBOX_ENABLED=true
# 沙箱实现：local=项目内置受限本地执行（默认，零安装）；docker=远程 Docker 沙箱（未来升级项，当前配置即启动报错）
SANDBOX_PROVIDER=local
# write_file 单文件内容上限（UTF-8 字节）
#WRITE_MAX_BYTES=262144
# 命令白名单（逗号分隔，按首词匹配；Windows 大小写不敏感）
#EXEC_WHITELIST=python,pip,pytest,node,npm,npx,git,mvn,java,javac,dir,ls,echo,type,cd
# 追加黑名单正则（逗号分隔，与内置默认合并；内置已覆盖 rm -r、del /s、format、taskkill 等）
#EXEC_BLACKLIST=
# run_command 硬超时秒数（超时 taskkill /F /T 终止整棵进程树）
#EXEC_TIMEOUT_SECONDS=60
# 命令输出捕获上限（字节，超限截断）
#EXEC_MAX_OUTPUT_BYTES=65536
# confirm 人机确认等待秒数（超时自动拒绝；用户点确认/拒绝立即唤醒）
#CONFIRM_TIMEOUT_SECONDS=120

# ---- 阶段4A：MCP client（接入外部 MCP server） ----
# MCP 开关（true/false）；false（默认）时零加载零连接零注册。
# 阶段4C 起 env 仅作初始回落默认：ai/config/features.json 优先（前端可热切换），
# 文件/字段缺失时才读本项；程序不回写 .env
MCP_ENABLED=false
# MCP server 配置（JSON 数组，stdio 传输）：name/command 必填，args/env 可选。
# 仅支持 tools 能力；server 进程以当前用户权限运行，能力域在 Workspace 沙箱之外，
# 请只配置可信来源的 server。阶段4C 起可在前端「MCP 工具 → 配置」弹层热更新
# （保存即热重连，持久化到 ai/config/features.json）；本项仅在 features.json 缺失时作初始默认。
# 示例（文件系统 server）：
# MCP_SERVERS=[{"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","C:/demo"]}]
# MCP_SERVERS=[]
# 单 server 连接+枚举工具超时秒数（超时 WARN 跳过该 server，不阻断 AI 启动）
#MCP_CONNECT_TIMEOUT_SECONDS=10
# 单次外部工具调用硬超时秒数（超时收敛为 error，流不断）
#MCP_TOOL_TIMEOUT_SECONDS=60

# ---- 阶段4B：Multi-Agent 子任务委派 ----
# 多 Agent 开关（true/false）；false（默认）时零注册零行为
# （模型请求 delegate_task 会得到"未知工具"降级，流不断）。
# 阶段4C 起可在前端「任务委派」pill 热切换；env 仅作 features.json 缺失时的初始默认
MULTI_AGENT_ENABLED=false
# 子 agent 独立轮次上限（与主循环 MAX_TOOL_ITERATIONS 叠加构成双层预算）
#MAX_SUB_ITERATIONS=8
# 子任务总时长硬顶秒数（per-tool 兜底超时 +10s 缓冲；超时后请求线程确定终结）
#SUB_TASK_TIMEOUT_SECONDS=600
# 子 agent 结论进入摘要的字符上限（超长截断，防 token 失控）
#SUB_OUTPUT_MAX_CHARS=8000
